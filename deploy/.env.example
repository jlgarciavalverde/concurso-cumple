# ~/servicios/concurso/.env (permisos 600). El PIN lo genera tools/deploy.mjs la primera vez.
PIN=
APP_VERSION=
PUBLIC_URL=https://concurso.redgarverde.com
# Spotify (opcional). Crear la app en https://developer.spotify.com/dashboard con la cuenta Premium:
#   Redirect URI: https://concurso.redgarverde.com/api/spotify/callback · APIs: Web API y Web Playback SDK
# Guardarlos sin pegarlos en ningún chat:
#   read -rsp "Client ID: " A && echo && read -rsp "Client secret: " B && echo && sed -i '/^SPOTIFY_CLIENT_/d' .env && printf 'SPOTIFY_CLIENT_ID=%s\nSPOTIFY_CLIENT_SECRET=%s\n' "$A" "$B" >> .env && unset A B && docker compose up -d
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
